# Caring Contacts environment variables (copied from PsychSift .env.example).
# Copy this file to .env.local and fill in only what you need. For local demo use, nothing is required.

# --- Caring Contacts workspace (synthetic prototype; see docs/deployment-architecture.md §4) ---
# The ONE variable that switches the Caring Contacts workspace from its in-memory demo
# store to Postgres. Read only by src/lib/caring-contacts-server/config.ts, never by
# env.ts, and only by the app tier (Railway service `Database`) — the worker never reads it.
# Unset or blank = in-memory (the demo and the offline suites). Set = every workspace
# read and write goes to this database. Fails closed on misconfiguration: the process
# refuses a URL naming the PsychSift project ref, or one byte-identical to SUPABASE_DB_URL
# / DATABASE_URL, so this prototype can never point at the live clinical database.
# The login role in the URL must be a member of `caring_contacts_app` (migration 0001
# grants membership only to the role that ran the migration); otherwise every
# transaction's `set local role caring_contacts_app` fails and the workspace 500s.
# Not set on any deployment today: the workspace itself is locked in production.
#CARING_CONTACTS_DATABASE_URL=postgresql://caring_contacts_owner:password@127.0.0.1:54329/postgres

# Caring Contacts LIVE sovereign mode. Setting CARING_CONTACTS_DEMO_ENABLED=false arms a boot
# gate (src/instrumentation.ts) that refuses to start unless every variable below is present,
# because live mode resolves its actor from a signed production session cookie rather than the
# forgeable demo role cookie, and a half-configured live deployment fails per request instead of
# at boot. Not set on any deployment today.
#CARING_CONTACTS_DEMO_ENABLED=false
#CARING_CONTACTS_SESSION_HMAC_SECRET=
#CARING_CONTACTS_GOVERNANCE_ATTESTATION_JSON=
#CARING_CONTACTS_GOVERNANCE_ATTESTATION_MAC=
#CARING_CONTACTS_GOVERNANCE_HMAC_SECRET=

# Staff sign-in for live mode (OpenID Connect, authorization code flow with PKCE). The session
# cookie live mode needs is minted only after the identity provider's ID token is verified and
# the person's groups map to a role and ONE team; anyone else is refused. Ignored in demo mode.
# Routes: /api/caring-contacts/auth/sign-in, /callback, /sign-out. See deploy/australia/README.md
# "Staff sign-in" for what to set up at the identity provider.
#
# The identity provider's issuer URL, exactly as its /.well-known/openid-configuration states it
# (https only; no trailing slash unless the provider's own issuer has one).
#CARING_CONTACTS_SESSION_ISSUER=https://login.example.health.wa.gov.au/realms/caring-contacts
#CARING_CONTACTS_OIDC_CLIENT_ID=
#CARING_CONTACTS_OIDC_CLIENT_SECRET=
# Must be this app's public address + /api/caring-contacts/auth/callback, registered at the provider.
#CARING_CONTACTS_OIDC_REDIRECT_URL=https://caringcontacts.example.health.wa.gov.au/api/caring-contacts/auth/callback
# JSON: identity-provider group -> role (or list of roles). Roles: coordinator, teamLead, auditor,
# clinicalProgrammeLead, livedExperienceRepresentative. Several mapped groups add their roles together.
#CARING_CONTACTS_OIDC_ROLE_MAP={"CC-Coordinators":"coordinator","CC-Team-Leads":["teamLead","coordinator"],"CC-Auditors":"auditor"}
# JSON: identity-provider group -> Caring Contacts team id. A person must map to exactly one team.
#CARING_CONTACTS_OIDC_TEAM_MAP={"CC-Team-North":"team-north","CC-Team-South":"team-south"}
# Optional. The ID token claim that lists the groups (dotted paths allowed, e.g. realm_access.roles). Default: groups
#CARING_CONTACTS_OIDC_GROUPS_CLAIM=groups
# Optional. Extra scopes (openid is always sent), e.g. "groups" for providers that need it.
#CARING_CONTACTS_OIDC_SCOPES=
# Optional. Where the provider sends the browser after sign-out (register it there too).
#CARING_CONTACTS_OIDC_POST_LOGOUT_REDIRECT_URL=

# Live mode: who holds each service-restart approval seat (governance configuration). After a
# service-wide stop, sending restarts only when all three seats approve, each by a DIFFERENT person
# named for that seat here. Values are staff identifiers as the signed session carries them.
# Unset or malformed means nobody holds any seat, so a stop cannot be restarted until this is set.
#CARING_CONTACTS_RESTART_APPROVAL_SEATS={"incidentLead":["staff-id-1"],"privacySecurityOwner":["staff-id-2"],"clinicalProgrammeLead":["staff-id-3"]}

# --- Caring Contacts text messages (see deploy/australia/README.md "Text messages") ---
# Default: simulated. Nothing is ever sent to a phone unless CARING_CONTACTS_SMS_TRANSPORT=telstra
# AND every Telstra/public-address/webhook-secret line below is set AND live mode is on; a
# half-configured real setup refuses to send rather than quietly simulating.
#CARING_CONTACTS_SMS_TRANSPORT=simulated
#CARING_CONTACTS_TELSTRA_CLIENT_ID=
#CARING_CONTACTS_TELSTRA_CLIENT_SECRET=
#CARING_CONTACTS_TELSTRA_FROM=+61400000000
# Only Telstra's Australian API hosts over https are accepted:
#CARING_CONTACTS_TELSTRA_API_BASE_URL=https://products.api.telstra.com
#CARING_CONTACTS_PUBLIC_BASE_URL=https://caringcontacts.example.gov.au
# 32+ characters; signs each per-message delivery-report address:
#CARING_CONTACTS_DELIVERY_WEBHOOK_SECRET=
# 32+ characters. Incoming texts (POST /api/caring-contacts/inbound/webhook): the carrier sends it as
# the "x-caring-contacts-inbound-secret" header, "Authorization: Bearer <secret>", or "?token=<secret>".
# Unset or shorter = the route answers 404 and incoming texts are not received.
#CARING_CONTACTS_INBOUND_WEBHOOK_SECRET=
#
# The scheduled sender route (POST /api/caring-contacts/dispatch-run, "Authorization: Bearer <secret>").
# Unset = the route answers 404. Locally, with `npm run dev` running in another terminal:
#   CARING_CONTACTS_SENDER_URL=http://127.0.0.1:3000 CARING_CONTACTS_SENDER_SECRET=<same> npm run sender
#CARING_CONTACTS_SENDER_SECRET=
# Team ids to send for; defaults to the demo team only while the demo runs:
#CARING_CONTACTS_SENDER_TEAM_IDS=
#CARING_CONTACTS_SENDER_URL=http://127.0.0.1:3000
#CARING_CONTACTS_SENDER_INTERVAL_SECONDS=300
