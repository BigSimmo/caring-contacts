# Standalone extract note: this copy of Caring Contacts reads only the CARING_CONTACTS_* variables,
# PORT, NODE_ENV and NEXT_TELEMETRY_DISABLED. The Supabase and Sentry lines below were used by the
# wider PsychSift app and are ignored here; they are kept only for reference.
# ==============================================================================
# CARING CONTACTS — SOVEREIGN AUSTRALIAN DEPLOYMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Specification: docs/deployment/caring-contacts-sovereign-australia.md
# Incident / Hazard Resolution: Hazard H-36 (Issue #NCAWAF, ULID: 01M0B6WFEPNCAWAFRW03H3WSDY)
#
# JURISDICTION & SOVEREIGNTY REQUIREMENT:
# In compliance with the Privacy Act 1988 (Cth), Australian Privacy Principles
# (APP 8 & APP 11), My Health Records Act 2012, and WA Health Information
# Governance Policy (OD 0658/16), all Protected Health Information (PHI)
# relating to suicide aftercare must remain strictly within Australia.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sovereign Australian Location & Egress Lockdown
# ------------------------------------------------------------------------------
# Pinned Australian cloud region (AWS ap-southeast-2 Sydney or Azure australiaeast)
CARING_CONTACTS_REGION=ap-southeast-2

# Hard requirement: Enforces zero egress of patient health data outside Australia.
# Outbound network firewalls block US OpenAI and unauthorized international APIs.
ZERO_DATA_EGRESS_AUSTRALIA=true

# Service primary timezone (AWST for WA Health, or Australia/Sydney for NSW Health)
TIMEZONE=Australia/Perth

# ------------------------------------------------------------------------------
# 2. Dedicated Australian Supabase Database
# ------------------------------------------------------------------------------
# The dedicated Supabase project hosted strictly in Sydney (ap-southeast-2).
# REPLACE <sydney-project-ref> with the dedicated project reference provisioned for Caring Contacts.
# The ref must be a 20-char lowercase alphanumeric Supabase project ref, distinct from PsychSift.
SUPABASE_URL=https://<sydney-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<sydney-project-ref>.supabase.co
SUPABASE_PROJECT_REF=<sydney-project-ref>
SUPABASE_PROJECT_NAME=Caring Contacts Australia

# Register this dedicated project with assertExpectedSupabaseProjectConfig without weakening
# PsychSift separation. Both vars are required; the ref must NOT equal the PsychSift production
# ref (sjrfecxgysukkwxsowpy) or any stale/staging PsychSift identity.
SUPABASE_CARING_CONTACTS_PROJECT_REF=<sydney-project-ref>
SUPABASE_CARING_CONTACTS_PROJECT_NAME=Caring Contacts Australia

# Client-side publishable key for the dedicated Sydney Supabase instance
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sydney_live_placeholder

# Server-side service role key (Never expose to client bundle)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_sydney_live_placeholder

# CRITICAL DATABASE SEPARATION GUARD (src/lib/caring-contacts-server/config.ts):
# Caring Contacts must connect to its own dedicated database and NEVER share a
# connection with the PsychSift knowledge base.
# The server executes `assertNotClinicalKbProject(url)` on boot:
# - It refuses to start if this URL contains 'sjrfecxgysukkwxsowpy'.
# - It refuses to start if this URL matches DATABASE_URL or SUPABASE_DB_URL.
CARING_CONTACTS_DATABASE_URL=postgresql://postgres:[DATABASE_PASSWORD]@db.<sydney-project-ref>.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Mode Flags & Clinical Safeguards
# ------------------------------------------------------------------------------
# Production real-patient mode must disable training isolation mode
NEXT_PUBLIC_CARING_CONTACTS_TRAINING_MODE=false

# Demo Role Switcher vs Governed Live Mode:
# Default FALSE for production sovereign deploys that also set CARING_CONTACTS_DATABASE_URL.
# Set to 'true' ONLY for an isolated clinical simulation / staging evaluation that must NOT
# share a real-patient database (use a dedicated demo DB or leave CARING_CONTACTS_DATABASE_URL
# unset so the in-memory demo store is used). Never enable demo against a live patient DB.
# Set to 'false' for live clinical operation under WA Health Enterprise SSO authentication.
# Production NODE_ENV ignores this flag unless CARING_CONTACTS_SESSION_HMAC_SECRET is also set
# (HMAC gates enablement / signs cookies; it is not human authentication). Live mode additionally
# requires CARING_CONTACTS_DATABASE_URL, a signed production-session cookie from enterprise SSO,
# and a MAC-authenticated governance attestation at boot (see vars below).
CARING_CONTACTS_DEMO_ENABLED=false

# HMAC secret for signed Caring Contacts session cookies (required in production for either mode).
# Generate with: openssl rand -hex 32
CARING_CONTACTS_SESSION_HMAC_SECRET=replace-with-32-byte-hex-session-hmac-secret

# Live mode only (CARING_CONTACTS_DEMO_ENABLED=false): MAC-authenticated CSO attestation JSON.
# MAC = hex(HMAC-SHA256(CARING_CONTACTS_GOVERNANCE_HMAC_SECRET, ATTESTATION_JSON_BYTES))
# CARING_CONTACTS_GOVERNANCE_ATTESTATION_JSON={"attestationVersion":"1.0.0",...}
# CARING_CONTACTS_GOVERNANCE_ATTESTATION_MAC=<hex-mac>
# CARING_CONTACTS_GOVERNANCE_HMAC_SECRET=replace-with-governance-hmac-secret

# ------------------------------------------------------------------------------
# 3a. Staff sign-in (live mode only) -- OpenID Connect to the health service's identity provider
# ------------------------------------------------------------------------------
# Live mode refuses to start unless every non-optional line here is set. The app keeps no
# passwords: staff sign in at the identity provider, and the app mints its own 8-hour session
# cookie only after verifying the provider's signed ID token and mapping the person's groups to a
# role and exactly one team. See deploy/australia/README.md "Staff sign-in".
# The identity provider must itself be hosted in Australia (H-36) and reachable over HTTPS from
# the container (allow it in the egress rules).
#
# Issuer URL, exactly as the provider's /.well-known/openid-configuration states it (https only).
CARING_CONTACTS_SESSION_ISSUER=https://<identity-provider>/<issuer-path>
CARING_CONTACTS_OIDC_CLIENT_ID=replace-with-client-id
# Secret: keep it in Secrets Manager / Key Vault, never in a committed file.
CARING_CONTACTS_OIDC_CLIENT_SECRET=replace-with-client-secret
# This app's public address + /api/caring-contacts/auth/callback, registered at the provider.
CARING_CONTACTS_OIDC_REDIRECT_URL=https://caringcontacts.health.wa.gov.au/api/caring-contacts/auth/callback
# JSON: provider group -> role, or list of roles. Roles: coordinator, teamLead, auditor,
# clinicalProgrammeLead, livedExperienceRepresentative.
CARING_CONTACTS_OIDC_ROLE_MAP={"CC-Coordinators":"coordinator","CC-Team-Leads":["teamLead","coordinator"],"CC-Auditors":"auditor"}
# JSON: provider group -> Caring Contacts team id. Each person must map to exactly one team.
CARING_CONTACTS_OIDC_TEAM_MAP={"CC-Team-North":"team-north"}
# Optional: the ID token claim listing groups (dotted paths allowed). Default: groups
#CARING_CONTACTS_OIDC_GROUPS_CLAIM=groups
# Optional: extra scopes beyond openid (e.g. groups)
#CARING_CONTACTS_OIDC_SCOPES=
# Optional: where the provider sends the browser after sign-out (register it at the provider too)
#CARING_CONTACTS_OIDC_POST_LOGOUT_REDIRECT_URL=https://caringcontacts.health.wa.gov.au/

# ------------------------------------------------------------------------------
# 3b. Text messages (real sending is OFF unless every line here is set)
# ------------------------------------------------------------------------------
# See deploy/australia/README.md "Text messages". Unset or "simulated" = nothing is ever sent.
# "telstra" = real messages through the Telstra Messaging API (Australian carrier). Needs live mode.
# The adapter must be checked against Telstra's current API documentation before real use.
CARING_CONTACTS_SMS_TRANSPORT=simulated
#CARING_CONTACTS_TELSTRA_CLIENT_ID=replace-with-telstra-client-id
# Secret: keep it in Secrets Manager / Key Vault.
#CARING_CONTACTS_TELSTRA_CLIENT_SECRET=replace-with-telstra-client-secret
# The Australian virtual number (+614...) or approved sender name messages come from.
#CARING_CONTACTS_TELSTRA_FROM=+61400000000
# Leave unset. Only Telstra's Australian API hosts over https are accepted; anything else refuses.
#CARING_CONTACTS_TELSTRA_API_BASE_URL=https://products.api.telstra.com
# This service's public https address; delivery reports come back to
# <this>/api/caring-contacts/delivery/webhook on a per-message signed address.
#CARING_CONTACTS_PUBLIC_BASE_URL=https://caringcontacts.health.wa.gov.au
# At least 32 characters (openssl rand -hex 32). Signs each delivery-report address.
#CARING_CONTACTS_DELIVERY_WEBHOOK_SECRET=replace-with-64-hex-characters
# At least 32 characters, and different from every other secret. Configure the carrier's
# incoming-message callback as <this service>/api/caring-contacts/inbound/webhook carrying it
# (header "x-caring-contacts-inbound-secret", a Bearer token, or "?token="). Unset = the route does
# not exist and replies to the service's number are not received.
#CARING_CONTACTS_INBOUND_WEBHOOK_SECRET=replace-with-64-hex-characters
#
# The scheduled sender. POST /api/caring-contacts/dispatch-run with "Authorization: Bearer <this>"
# every few minutes, from a scheduler or `npm run sender`. Unset = the route does not exist.
#CARING_CONTACTS_SENDER_SECRET=replace-with-64-hex-characters
# Comma-separated team ids the sender works for (live mode sends for no team unless listed).
#CARING_CONTACTS_SENDER_TEAM_IDS=team-north
# Only for `npm run sender` (the loop that calls the route):
#CARING_CONTACTS_SENDER_URL=https://caringcontacts.health.wa.gov.au
#CARING_CONTACTS_SENDER_INTERVAL_SECONDS=300

# ------------------------------------------------------------------------------
# 3c. Staff alerts and the sender health check (see deploy/australia/README.md "Staff alerts")
# ------------------------------------------------------------------------------
# Alerts hold only an alert type, a count, a fixed reason code and a team id -- never a patient's
# name, number or message. "simulated" keeps them in memory and in the log only. "webhook" posts
# each alert as JSON to ONE team-channel address: a Teams/Slack-style incoming webhook or an email
# relay, over https. Setting only one of the two lines is refused and the readiness probe answers 503.
# Set this to webhook before real sending: otherwise a failed message is only in the log.
#CARING_CONTACTS_ALERT_DELIVERY=webhook
# Secret: the address itself is the credential. Keep it in Secrets Manager / Key Vault.
#CARING_CONTACTS_ALERT_WEBHOOK_URL=replace-with-the-team-channel-webhook-address
# How long the same alert is held back while its problem continues (minutes, default 60).
#CARING_CONTACTS_ALERT_COOLDOWN_MINUTES=60
# With real sending or live mode on, the readiness probe answers 503 and raises a "sender stalled"
# alert when no sender run has finished for this many minutes (default 15). Keep it well above the
# sender interval (300 seconds).
#CARING_CONTACTS_SENDER_STALL_MINUTES=15

# ------------------------------------------------------------------------------
# 4. Observability & Privacy-Preserving Telemetry
# ------------------------------------------------------------------------------
# Enforce strict in-memory scrubbing of Australian mobile numbers (+61 4xx / 04xx),
# patient names, UMRNs, and message contents before telemetry dispatch.
SENTRY_PII_SCRUBBING=true

# Sentry DSN pointing to an Australian Sentry Relay or sovereign ingest endpoint
# Leave blank if running in an air-gapped sovereign VPC
SENTRY_DSN=https://<public_key>@sentry-relay.ap-southeast-2.internal/1

# Environment tag for telemetry filtering
SENTRY_ENVIRONMENT=production-au-sovereign

# Sample rate for performance tracing (0.0 to 1.0; recommended 0.1 for production)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable structured server logs (PII is sanitized before emission)
SENTRY_ENABLE_LOGS=true

# ------------------------------------------------------------------------------
# 5. Application Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Production Host FQDN (Behind WA Health reverse proxy or AWS ALB)
APP_URL=https://caringcontacts.health.wa.gov.au
